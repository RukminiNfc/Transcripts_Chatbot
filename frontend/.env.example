# Copy to frontend/.env and set per machine. frontend/.env is gitignored, so each machine keeps
# its own values and `git pull` never overwrites them.
#
# Both values are baked in at build time: after changing them, re-run `npm run build`
# (or restart `npm run dev`).
#
# Local development: leave both unset — the defaults are "/" and http://localhost:8001.

# Path the app is served under. Server: /TranscriptionVal/
VITE_BASE_PATH=/

# Backend address. A full URL, or a path on the same host when a proxy forwards it.
# Server: /transcription-api
VITE_API_URL=http://localhost:8001
