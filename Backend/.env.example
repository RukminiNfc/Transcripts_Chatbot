# Copy to Backend/.env and fill in. Never commit the real .env — it is gitignored.
#
# NOTE: config.py sets `extra = "ignore"`, so a MISSPELLED key here is silently dropped and the
# code-level default is used instead. Check the log line the app prints on startup if a setting
# does not seem to take effect.

# ─── Required ────────────────────────────────────────────────────────────────
# No default — the app will not start without these.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
OPENAI_API_KEY=sk-...

# ─── Security (set this before any non-local deployment) ─────────────────────
# config.py ships an insecure placeholder default. If this key is absent, that placeholder is
# used and every issued JWT is forgeable by anyone who has read the source.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Vector store ────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Models (per role; see config.py for what each one drives) ───────────────
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_EXTRACTION_MODEL=gpt-5.5
OPENAI_FORMAT_MODEL=gpt-5.4-mini
OPENAI_COMPARISON_MODEL=gpt-5.4-mini
OPENAI_RESOLVER_MODEL=gpt-5.5

# ─── Requirement extraction from the raw transcript ──────────────────────────
# Feeds comparison, and nothing else reads it. With module documents in use (see
# ENABLE_MODULE_DOCS) requirements come from the minutes instead, so this pass costs ~$0.27
# and ~90 seconds per transcript for output nobody consumes. Turning it off deletes nothing:
# extractions already saved on past transcripts stay replayable. Comparison cannot run
# without it — leave True if ENABLE_COMPARISON is True.
ENABLE_EXTRACTION=True

# ─── Comparison stage ────────────────────────────────────────────────────────
# Comparison is ~73% of the cost of processing a transcript and is the only writer of the
# requirements table. Set to False to ingest, extract and generate minutes at roughly a
# quarter of the cost; the extraction is saved on the transcript so comparison can be run
# later without re-extracting. While False, chat answers that read requirements
# ("how many requirements", "what changed") return nothing. Minutes are unaffected.
ENABLE_COMPARISON=True

# ─── Automatic minutes ───────────────────────────────────────────────────────
# Set to False to skip generating minutes on upload (~$0.37 each) — useful for a bulk
# backfill. Minutes can still be generated per meeting from the Minutes page at any time.
ENABLE_AUTO_MOM=True

# ─── Module documents ────────────────────────────────────────────────────────
# Classify the minutes into the project's modules, update each touched module's living
# document, then re-index it for chat. Replaces per-requirement comparison: ~3-5 LLM calls
# (~$0.15) instead of ~113 ($1.73). Needs minutes, so ENABLE_AUTO_MOM must be True for this
# to run on upload. Do NOT run alongside ENABLE_COMPARISON — both write the requirements
# table and would overwrite each other.
ENABLE_MODULE_DOCS=False

# ─── Retrieval re-ranker (optional) ──────────────────────────────────────────
# Leave blank to disable: the reranker degrades gracefully to top-N by embedding score.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ─── Retrieval tuning ────────────────────────────────────────────────────────
# Tune these against Backend/eval/run_eval.py. Never hardcode a threshold in a service.
RETRIEVAL_CANDIDATE_POOL=60
RETRIEVAL_TOP_N_NARROW=8
RETRIEVAL_TOP_N_BROAD=30
RERANK_SCORE_THRESHOLD=0.1
RERANK_COMPLETE_THRESHOLD=0.3
RERANK_CHANGES_THRESHOLD=0.3
RERANK_COMPLETE_GATHER_THRESHOLD=0.1

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ─── Deployment ──────────────────────────────────────────────────────────────
# Local development: leave these at the defaults below. Server values in the comments.
# The frontend has its own two settings in frontend/.env.example (base path + API address).
# Path prefix the proxy serves the API under. Server: /transcription-api
ROOT_PATH=
# Port run.py listens on. Server: 8003
PORT=8001
# Auto-restart on code changes. Server: False
RELOAD=True

# ─── Email change notifications (currently DISABLED in worker/tasks.py) ──────
# Left blank by default. _send_email refuses to send unless HOST, USER and FROM_EMAIL are all set,
# so a partial config fails loudly rather than mailing from the wrong address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── Azure DevOps (Boards) — MOM action items → Tasks ────────────────────────
# When an admin approves a MOM, its reviewed action items are created as Tasks in the customer's
# ADO project (project / area path are set per customer, not here).
# If ADO_ENABLED=true, all three below are REQUIRED — the app refuses to start without them.
# Use a SERVICE-ACCOUNT PAT with scope "Work Items (Read & Write)" only; rotate before it expires.
ADO_ENABLED=false
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=
# Frontend base URL (no trailing slash). Each Task's description links to <APP_PUBLIC_URL>/minutes/<id>.
# Required when EITHER tracker is enabled.
APP_PUBLIC_URL=http://localhost:5173

# ─── Jira Cloud — the alternative tracker ────────────────────────────────────
# Each customer uses ONE tracker (Azure Boards or Jira), chosen in Customer Settings along with its
# Jira project key. If JIRA_ENABLED=true, all three below (and APP_PUBLIC_URL) are REQUIRED.
# The account needs: Browse projects, Create issues, Assign issues in the target projects, plus the
# global "Browse users and groups" permission (used to look assignees up by email).
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourco.atlassian.net
JIRA_EMAIL=
# Create at id.atlassian.com → Security → API tokens. Treat like a password.
JIRA_API_TOKEN=

# ─── Mantis (task.nfcsolutionsusa.com) — the internal task app ───────────────
# Each customer's Mantis project name and category are set in Customer Settings. The assignee's
# Mantis username is taken from their email prefix (jdoe@… → jdoe); if Mantis doesn't know that
# user, the ticket is created unassigned with a warning.
# If MANTIS_ENABLED=true, both below (and APP_PUBLIC_URL) are REQUIRED.
MANTIS_ENABLED=false
# REST root. If /api/rest/issues returns 404 (Apache rewrites off), use .../api/rest/index.php instead.
MANTIS_API_URL=https://task.nfcsolutionsusa.com/api/rest
# Log in as the integration account → My Account → API Tokens. Sent as-is (no "Bearer").
# Tickets show this account as the reporter. Treat like a password.
MANTIS_API_TOKEN=
